rules_version = '2';
// Loopmates: the server (firebase-admin) does all reads and writes. The browser and phone only read two things:
//   servers/{uid}      where the owner's Loopmates server is (written by the server after pairing)
//   pairings/{code}    the server URL behind a 6-digit pairing code (get by id only, no listing)
// Deploy: firebase deploy --only firestore:rules   (or paste into Firebase console → Firestore → Rules)
service cloud.firestore {
  match /databases/{database}/documents {
    match /servers/{uid} {
      allow get: if request.auth != null && request.auth.uid == uid;
    }
    match /pairings/{code} {
      allow get: if request.auth != null;
    }
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
