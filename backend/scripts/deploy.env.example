# Copy to scripts/deploy.env and fill in. deploy.env is git-ignored. NEVER commit it.
# One Render API key per account (Render -> Account Settings -> API Keys). Rotate them after the first deploy if they were ever pasted anywhere.
RENDER_KEY_API=
RENDER_KEY_CODER=
RENDER_KEY_ARTIFACTS=

# Optional: pick the workspace if an account has several (otherwise the first one is used). Format: tea-xxxxxxxx or own-xxxxxxxx
RENDER_OWNER_API=
RENDER_OWNER_CODER=
RENDER_OWNER_ARTIFACTS=

GITHUB_REPO=https://github.com/StarDust-Git-Code/loop
GITHUB_BRANCH=main
REGION=singapore

# Where the dashboard lives (CORS) and who may sign in (comma-separated Google emails)
DASHBOARD_ORIGIN=https://dashboard-loopmates.vercel.app
ALLOWED_EMAILS=mailboxofirshadahamed@gmail.com

# Firebase: Project settings -> Service accounts -> Generate new private key. Path to the downloaded JSON (stays on your PC).
FIREBASE_SERVICE_ACCOUNT_FILE=C:\path\to\loop-mates-firebase-adminsdk.json

# Google Drive (node scripts/drive-token.mjs <id> <secret>)
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REFRESH_TOKEN=

# LLM keys for the platform fallback (add as many as you have; at least one)
NVIDIA_API_KEY=
GEMINI_API_KEY=
GROQ_API_KEY=
CEREBRAS_API_KEY=
OPENROUTER_API_KEY=

# Optional
TELEGRAM_BOT_TOKEN=
GITHUB_TOKEN=
WHATSAPP_ENABLED=0

# Generated for you on first run (do not edit; losing MASTER_KEY makes stored API keys unreadable)
SERVICE_SECRET=
MASTER_KEY=
CRON_SECRET=
TELEGRAM_WEBHOOK_SECRET=
NAME_SUFFIX=
