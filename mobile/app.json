{
  "expo": {
    "name": "Loopmates",
    "slug": "loopmates",
    "scheme": "loopmates",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "automatic",
    "backgroundColor": "#FAF9FD",
    "newArchEnabled": true,
    "splash": {
      "image": "./assets/splash-icon.png",
      "resizeMode": "contain",
      "backgroundColor": "#6A4DF4"
    },
    "android": {
      "package": "com.loopmates.app",
      "versionCode": 1,
      "adaptiveIcon": {
        "backgroundColor": "#6A4DF4",
        "foregroundImage": "./assets/android-icon-foreground.png",
        "backgroundImage": "./assets/android-icon-background.png",
        "monochromeImage": "./assets/android-icon-monochrome.png"
      },
      "predictiveBackGestureEnabled": false,
      "softwareKeyboardLayoutMode": "resize",
      "intentFilters": [
        {
          "action": "VIEW",
          "category": [
            "BROWSABLE",
            "DEFAULT"
          ],
          "data": [
            {
              "scheme": "loopmates"
            },
            {
              "scheme": "https",
              "host": "dashboard-loopmates.vercel.app",
              "pathPrefix": "/call"
            }
          ]
        }
      ],
      "permissions": [
        "android.permission.POST_NOTIFICATIONS",
        "android.permission.RECEIVE_BOOT_COMPLETED"
      ]
    },
    "plugins": [
      "expo-router",
      "expo-font",
      [
        "react-native-audio-api",
        {
          "androidPermissions": [
            "android.permission.RECORD_AUDIO",
            "android.permission.MODIFY_AUDIO_SETTINGS"
          ],
          "androidForegroundService": false,
          "disableFFmpeg": true,
          "iosBackgroundMode": false
        }
      ],
      [
        "expo-build-properties",
        {
          "android": {
            "minSdkVersion": 26,
            "compileSdkVersion": 37,
            "targetSdkVersion": 35,
            "enableProguardInReleaseBuilds": false
          }
        }
      ],
      "@react-native-google-signin/google-signin",
      [
        "expo-notifications",
        {
          "color": "#6A4DF4"
        }
      ],
      [
        "expo-speech-recognition",
        {
          "microphonePermission": "Loopmates uses the microphone so you can dictate messages.",
          "speechRecognitionPermission": "Loopmates uses speech recognition to turn your voice into text.",
          "androidSpeechServicePackages": [
            "com.google.android.googlequicksearchbox"
          ]
        }
      ],
      [
        "expo-image-picker",
        {
          "photosPermission": "Loopmates lets you attach photos to chats.",
          "cameraPermission": "Loopmates lets you take a photo to attach."
        }
      ],
      [
        "react-native-android-widget",
        {
          "widgets": [
            {
              "name": "LoopQuick",
              "label": "Loopmates",
              "description": "Jump to a chat, a call or your runs",
              "minWidth": "250dp",
              "minHeight": "110dp",
              "targetCellWidth": 4,
              "targetCellHeight": 2,
              "resizeMode": "horizontal",
              "updatePeriodMillis": 0
            }
          ]
        }
      ]
    ],
    "experiments": {
      "typedRoutes": false
    }
  }
}